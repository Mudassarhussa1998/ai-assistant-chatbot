# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Password for the admin panel at /admin (use a long random value)
ADMIN_TOKEN=change-me-to-a-long-random-password

# Optional
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# low | medium | high (low = fastest replies)
GEMINI_THINKING_LEVEL=low
SYSTEM_PROMPT=You are an AI assistant. Your main purpose is to be integrated into any system and help its users. Be friendly, clear and concise.
# Comma-separated sites allowed to call the API from the browser, e.g. https://example.com
ALLOWED_ORIGINS=*
# How many knowledge-base chunks to retrieve per search
RAG_TOP_K=4
