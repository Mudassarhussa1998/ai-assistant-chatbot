# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high (low = fastest replies)
GEMINI_THINKING_LEVEL=low
PORT=3000
SYSTEM_PROMPT=You are an AI assistant. Your main purpose is to be integrated into any system and help its users. Be friendly, clear and concise.
# Comma-separated sites allowed to use the chat API, e.g. https://example.com,https://www.example.com
ALLOWED_ORIGINS=*
